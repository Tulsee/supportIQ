# Copy to .env and adjust for your machine. Never commit .env.
# The backend reads ./.env and backend/.env (later wins); real env vars override both.

# --- Backend -----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Async SQLAlchemy URL (asyncpg driver). Used by the API and by Alembic.
DATABASE_URL=postgresql+asyncpg://supportiq:supportiq@localhost:5432/supportiq
DATABASE_ECHO=false
