# Copy to .env and adjust for your machine. Never commit .env.
# The backend reads ./.env and backend/.env (later wins); real env vars override both.
# Every value below is optional in development: the defaults match docker-compose.yml.
# Use 127.0.0.1 rather than localhost: on Windows, localhost adds a ~2s IPv6
# fallback to every new connection.

# --- Docker Compose ------------------------------------------------------------
POSTGRES_USER=supportiq
POSTGRES_PASSWORD=supportiq
POSTGRES_DB=supportiq
POSTGRES_PORT=5433
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
QDRANT_PORT=6433
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Backend -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Runtime connection: the least-privilege role (no ownership, subject to RLS).
DATABASE_URL=postgresql+asyncpg://supportiq_app:supportiq_app@127.0.0.1:5433/supportiq
# Alembic only: the schema owner (DDL, grants, policies). Never used by the API.
MIGRATION_DATABASE_URL=postgresql+asyncpg://supportiq:supportiq@127.0.0.1:5433/supportiq
# Role the migrations grant privileges to; must be the user in DATABASE_URL.
DATABASE_APP_ROLE=supportiq_app
DATABASE_ECHO=false
# The test suite uses its own database (its schema is dropped on every run):
# TEST_DATABASE_URL=postgresql+asyncpg://supportiq_app:supportiq_app@127.0.0.1:5433/supportiq_test
# TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://supportiq:supportiq@127.0.0.1:5433/supportiq_test

REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth ------------------------------------------------------------------------
# Required outside development/test (min 32 chars). Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Must be true when served over HTTPS. Use samesite=none only if the frontend and
# API are on different sites (and then secure must be true).
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# --- Rate limits (max attempts per window, in seconds) ---------------------------
LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW_SECONDS=300
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_ACCOUNT_WINDOW_SECONDS=900
REGISTER_IP_LIMIT=10
REGISTER_IP_WINDOW_SECONDS=3600

# --- Email -----------------------------------------------------------------------
# smtp (dev: Mailpit, read mail at http://127.0.0.1:8025) or console (log only).
EMAIL_BACKEND=smtp
EMAIL_FROM=SupportIQ <no-reply@supportiq.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_STARTTLS=false

# --- Invitations -------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
INVITATION_EXPIRE_DAYS=7

# --- Maintenance -------------------------------------------------------------------
# Every N minutes (0 = off): purge expired refresh tokens and stale invitations, and
# mark document ingestions stuck longer than INGESTION_STALE_MINUTES as failed.
MAINTENANCE_INTERVAL_MINUTES=60
INGESTION_STALE_MINUTES=30

# --- Background jobs ------------------------------------------------------------------
# Celery broker (a separate Redis database). Start a worker from backend/ with:
#   uv run celery -A app.workers.celery_app worker --loglevel=info --pool=solo
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# --- Object storage (original documents) ---------------------------------------------
# s3: any S3-compatible service (dev: RustFS from docker-compose.yml, console at
# http://127.0.0.1:9001); local: a directory (LOCAL_STORAGE_DIR).
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=supportiq
S3_SECRET_ACCESS_KEY=supportiq-dev-secret
S3_REGION=us-east-1
S3_BUCKET=supportiq-documents
# LOCAL_STORAGE_DIR=.cache/storage

# --- Knowledge base ----------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6433
# QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=supportiq_chunks
# Any FastEmbed text model. Changing it needs a re-index (each model gets its own
# Qdrant collection). Downloaded on first use into MODEL_CACHE_DIR.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# MODEL_CACHE_DIR=.cache/models
# Measured with the model's tokenizer. BGE-small reads at most 510 content tokens.
CHUNK_SIZE_TOKENS=480
CHUNK_OVERLAP_TOKENS=72
# Retrieval (Module 4): candidates per retriever, Reciprocal Rank Fusion constant,
# candidates the cross-encoder reorders, and passages returned. BM25 runs in
# PostgreSQL with per-organization statistics.
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_SPARSE_TOP_K=20
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_CANDIDATES=20
RETRIEVAL_TOP_K=5
BM25_K1=1.2
BM25_B=0.75
# OCR for scanned PDF pages (pages with fewer extractable characters than the
# minimum), about 1-2 s per page on CPU, up to OCR_MAX_PAGES per document.
OCR_ENABLED=true
OCR_MIN_TEXT_CHARS=20
OCR_MAX_PAGES=200
OCR_DPI=200
MAX_UPLOAD_BYTES=20971520
MAX_DOCUMENT_PAGES=2000
MAX_EXTRACTED_CHARACTERS=5000000
# Per user: uploads per hour, searches per minute.
DOCUMENT_UPLOAD_LIMIT=30
KNOWLEDGE_SEARCH_LIMIT=60

# --- Answer generation ----------------------------------------------------------------
# ollama: a local model through Ollama (https://ollama.com); documents never leave the
#   machine. Install Ollama, then: ollama pull qwen3.5:4b (about 3.4 GB of memory).
# anthropic: Claude through the Anthropic API (needs ANTHROPIC_API_KEY; billed per use).
LLM_PROVIDER=ollama
# Per question. Keep below 300: the Next.js dev proxy gives up after 300 s.
LLM_TIMEOUT_SECONDS=240
# Questions per user, per minute.
AI_CHAT_LIMIT=20
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_OUTPUT_TOKENS=1024
# Context window (num_ctx): prompt plus answer. Larger uses more memory.
OLLAMA_CONTEXT_TOKENS=8192
# Let reasoning models think before answering (better on hard questions, much slower).
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max: answer quality against latency and cost.
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_OUTPUT_TOKENS=16000
