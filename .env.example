# Copy to .env and adjust for your machine. Never commit .env.
# The backend reads ./.env and backend/.env (later wins); real env vars override both.
# Every value below is optional in development: the defaults match docker-compose.yml.

# --- Docker Compose: PostgreSQL ------------------------------------------------
POSTGRES_USER=supportiq
POSTGRES_PASSWORD=supportiq
POSTGRES_DB=supportiq
POSTGRES_PORT=5433

# --- Backend -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Async SQLAlchemy URL (asyncpg driver), used by the API and Alembic. Keep 127.0.0.1
# rather than localhost: on Windows, localhost adds a ~2s IPv6 fallback per connection.
DATABASE_URL=postgresql+asyncpg://supportiq:supportiq@127.0.0.1:5433/supportiq
DATABASE_ECHO=false
# The test suite uses its own database (its schema is dropped on every run):
# TEST_DATABASE_URL=postgresql+asyncpg://supportiq:supportiq@127.0.0.1:5433/supportiq_test

# --- Auth ------------------------------------------------------------------------
# Required outside development/test (min 32 chars). Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Must be true when served over HTTPS. Use samesite=none only if the frontend and
# API are on different sites (and then secure must be true).
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
