# Copy to .env.local.

# Server-side only (not exposed to the browser).
# Where the Next.js server proxies /api/* requests (the FastAPI backend),
# including WebSocket upgrades for live ticket updates.
BACKEND_URL=http://127.0.0.1:8000

# Optional, exposed to the browser. Only needed when live updates must connect to
# a different host than the app itself (e.g. wss://api.example.com).
# NEXT_PUBLIC_WS_URL=
