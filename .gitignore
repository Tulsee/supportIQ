# --- Secrets / local config ----------------------------------------------------
# Never commit credentials. Only the template is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# --- Python (backend, ai_engine) ------------------------------------------------
# Keep uv.lock and .python-version tracked: they make the environment reproducible.
__pycache__/
*.py[cod]
.venv*/
venv/
*.egg-info/
build/
dist/

# Test / lint / coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Jupyter (experiments/notebooks)
.ipynb_checkpoints/

# --- Node / Next.js (frontend) ---------------------------------------------------
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- AI / data ---------------------------------------------------------------------
# Never commit customer documents, private evaluation data, or model weights.
uploads/
*.safetensors
*.pt
*.pth
*.onnx
*.gguf

# --- Logs ----------------------------------------------------------------------------
*.log
logs/

# --- Editors / OS / tools ----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.json
