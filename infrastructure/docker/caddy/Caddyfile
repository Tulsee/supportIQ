# One origin for the browser: the API under /api (WebSockets included) and its docs,
# everything else from Next.js. Same-origin keeps the httpOnly refresh cookie simple.
#
# SITE_ADDRESS defaults to plain HTTP on port 80 inside the container. Set it to a
# domain name (e.g. support.example.com) and publish ports 80 and 443, and Caddy
# obtains and renews an HTTPS certificate for it automatically.

{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Security headers on every response, the API's and the app's. Deleting headers
	# makes Caddy apply the whole block as the response is written, so these win over
	# anything the upstreams send. Checked in CI by check-headers.sh.
	header {
		# HTTPS only, for a year after a browser first sees the site over HTTPS (ignored
		# over plain HTTP). Not includeSubDomains: other subdomains aren't ours to bind.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No site may frame these pages (clickjacking); no plugins; <base> and form
		# targets stay on this origin. Scripts aren't restricted here: that needs
		# per-request nonces from Next.js.
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Don't advertise the software and versions behind the site.
		-Server
		-X-Powered-By
	}

	# No proxy timeout: answers from a local model on a CPU can take a minute or more.
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /redoc* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
